# Reference only — Phoenix does NOT read this file. It documents the
# environment variables config/runtime.exs expects in production, so
# you can copy these keys into Render's dashboard (Environment tab).
#
# Local dev secrets instead live in config/dev.secret.exs (gitignored).

# Required. Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Required. Your Neon pooled connection string.
# e.g. ecto://neondb_owner:PASSWORD@ep-xxx-pooler.c-8.us-east-2.aws.neon.tech/neondb
DATABASE_URL=

# Required — tells the release to actually start the Endpoint.
PHX_SERVER=true

# Optional. Defaults to 10 if unset; lower on memory-constrained plans.
POOL_SIZE=5

# Optional. Render sets RENDER_EXTERNAL_HOSTNAME automatically, which
# runtime.exs falls back to — only set this if you're on a custom domain.
# PHX_HOST=
